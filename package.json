{
  "name": "@dicsussion/protocol",
  "version": "0.5.0",
  "private": true,
  "description": "Headless, local-first, zero-knowledge P2P messaging protocol engine and SDK",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/HLessEnd/tsconfig.build.json",
    "build:circuits": "node scripts/build-circuits.mjs",
    "zk:build": "node scripts/build-circuits.mjs",
    "peer": "tsx scripts/peer-cli.mts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/uuid": "^10.0.0",
    "circom2": "^0.2.23",
    "snarkjs": "^0.7.6",
    "circomlib": "^2.0.5",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@number0/iroh": "^1.1.0",
    "@scure/bip39": "^2.2.0",
    "better-sqlite3": "^13.0.2",
    "crc-32": "^1.2.2",
    "lz4js": "^0.2.0",
    "multiformats": "^14.0.5",
    "poseidon-lite": "^0.3.0",
    "uuid": "^14.0.1"
  },
  "overrides": {
    "underscore": "^1.13.8"
  }
}
